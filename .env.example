ANTHROPIC_API_KEY=your-anthropic-api-key-here
COPILOT_MODEL=claude-sonnet-5
COPILOT_LLM_FALLBACK_MODELS=claude-haiku-4-5-20251001
COPILOT_LLM_TIMEOUT_S=8
COPILOT_LLM_DAILY_TOKEN_BUDGET=200000
COPILOT_AUDIT_FAIL_CLOSED=true
COPILOT_REGION=local

# Observability (optional). Leave keys empty to disable Langfuse entirely.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Use a Langfuse instance inside this region (self-hosted) for data residency.
LANGFUSE_HOST=http://localhost:3000
COPILOT_ENV=development
COPILOT_LANGFUSE_SAMPLE_RATE=1.0
# true exports questions and model prompts/outputs to Langfuse. Synthetic data only!
# Transaction payloads are never exported regardless of this flag.
COPILOT_OBS_CAPTURE_CONTENT=true
